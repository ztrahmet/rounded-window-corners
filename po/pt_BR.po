msgid "Switching keeps both lists"
msgstr "Trocar de lista mantém as duas"

#: prefs/appsPage.js
msgid "Blocklist"
msgstr "Lista de bloqueio"

#: prefs/appsPage.js
msgid "Allowlist"
msgstr "Lista de permissão"

#: prefs/appsPage.js
msgid "These apps are never rounded"
msgstr "Estes aplicativos nunca são arredondados"

#: prefs/appsPage.js
msgid "Only these apps are rounded"
msgstr "Somente estes aplicativos são arredondados"

#: prefs/generalPage.js
msgid "General"
msgstr "Geral"

