msgstr "O estilo de um aplicativo tem prioridade sobre o do seu kit de ferramentas"

#: prefs/appStylesPage.js
msgid "Needs Round libadwaita Apps"
msgstr "Requer “Arredondar aplicativos libadwaita”"

#: prefs/appStylesPage.js
msgid "Needs Round libhandy Apps"
msgstr "Requer “Arredondar aplicativos libhandy”"

