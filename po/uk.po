#: prefs/appChooser.js
msgid "Add App"
msgstr "Додати програму"

#: prefs/appChooser.js
msgid "Search apps"
msgstr "Шукати серед програм"

#: prefs/appListGroup.js
msgid "libadwaita Apps"
msgstr "Програми libadwaita"

#: prefs/appListGroup.js
msgid "libhandy Apps"
msgstr "Програми libhandy"

#: prefs/appListGroup.js
msgid "Wine Apps"
msgstr "Програми Wine"

#: prefs/appListGroup.js
msgid "Chromium and Electron Apps"
msgstr "Програми Chromium та Electron"

#: prefs/appListGroup.js
msgid "Firefox and Thunderbird"
msgstr "Firefox та Thunderbird"

#: prefs/appListGroup.js
msgid "Java Apps"
msgstr "Програми Java"

#: prefs/appListGroup.js
msgid "Qt Apps"
msgstr "Програми Qt"

#: prefs/appListGroup.js
msgid "GTK 4 Apps"
msgstr "Програми GTK 4"

#: prefs/appListGroup.js
msgid "GTK 3 Apps"
msgstr "Програми GTK 3"

#: prefs/appListGroup.js
msgid "Add App…"
msgstr "Додати програму…"

#: prefs/appListGroup.js
msgid "Add Toolkit"
msgstr "Додати інструментарій"

#: prefs/appListGroup.js
msgid "Remove"
msgstr "Вилучити"

#: prefs/appStylesPage.js
msgid "App Styles"
msgstr "Стилі"

#: prefs/appStylesPage.js
msgid "Apps and Toolkits"
msgstr "Програми та інструментарії"

#: prefs/appStylesPage.js
msgid "An app’s style comes before its toolkit’s"
msgstr "Стиль програми має перевагу над стилем її інструментарію"

#: prefs/appStylesPage.js
msgid "Needs Round libadwaita Apps"
msgstr "Потрібен параметр «Заокруглювати програми libadwaita»"

#: prefs/appStylesPage.js
msgid "Needs Round libhandy Apps"
msgstr "Потрібен параметр «Заокруглювати програми libhandy»"

#: prefs/appStylesPage.js
msgid "Replaces the toolkit and general styles"
msgstr "Замінює стиль інструментарію та загальний стиль"

#: prefs/appStylesPage.js
msgid "Replaces the general style"
msgstr "Замінює загальний стиль"

#: prefs/appsPage.js
msgid "Apps"
msgstr "Програми"

#: prefs/appsPage.js
msgid "Active List"
msgstr "Активний список"

#: prefs/appsPage.js
msgid "Switching keeps both lists"
msgstr "Під час перемикання обидва списки зберігаються"

#: prefs/appsPage.js
msgid "Blocklist"
msgstr "Список заборонених"

#: prefs/appsPage.js
msgid "Allowlist"
msgstr "Список дозволених"

#: prefs/appsPage.js
msgid "These apps are never rounded"
msgstr "Ці програми ніколи не заокруглюються"

#: prefs/appsPage.js
msgid "Only these apps are rounded"
msgstr "Заокруглюються лише ці програми"

#: prefs/generalPage.js
msgid "General"
msgstr "Загальне"

#: prefs/generalPage.js
msgid "Windows"
msgstr "Вікна"

#: prefs/generalPage.js
msgid "Round libadwaita Apps"
msgstr "Заокруглювати програми libadwaita"

#: prefs/generalPage.js
msgid "Only needed for a custom style or when maximized"
msgstr "Потрібно лише для власного стилю або розгорнутих вікон"

#: prefs/generalPage.js
msgid "Round libhandy Apps"
msgstr "Заокруглювати програми libhandy"

#: prefs/generalPage.js
msgid "Not all of them round their own windows"
msgstr "Не всі з них заокруглюють свої вікна самі"

#: prefs/generalPage.js
msgid "Round Maximized and Tiled Windows"
msgstr "Заокруглювати розгорнуті та прикріплені вікна"

#: prefs/generalPage.js
msgid "Without a shadow, as in libadwaita; fullscreen stays square"
msgstr "Без тіні, як у libadwaita; повноекранні вікна не заокруглюються"

#: prefs/generalPage.js
msgid "Round Overview Windows"
msgstr "Заокруглювати вікна в огляді"

#: prefs/generalPage.js
msgid "Off, the overview shows them as their apps draw them"
msgstr "Якщо вимкнено, огляд показує вікна так, як їх малюють програми"

#: prefs/generalPage.js
msgid "Keep Windows Sharp (Experimental)"
msgstr "Зберігати чіткість вікон (експериментально)"

#: prefs/generalPage.js
msgid "At fractional scales and in the overview"
msgstr "За дробового масштабу та в огляді"

#: prefs/generalPage.js
msgid "Replaces libadwaita’s style and gtk.css"
msgstr "Замінює стиль libadwaita та gtk.css"

#: prefs/generalPage.js
msgid "Reset All Settings…"
msgstr "Скинути всі налаштування…"

#: prefs/generalPage.js
msgid "Reset All Settings?"
msgstr "Скинути всі налаштування?"

#: prefs/generalPage.js
msgid "Every switch, list and style goes back to its default"
msgstr "Усі перемикачі, списки та стилі повернуться до типових значень"

#: prefs/generalPage.js
msgid "Cancel"
msgstr "Скасувати"

#: prefs/generalPage.js
msgid "Reset"
msgstr "Скинути"

#: prefs/styleGroups.js
msgid "Opacity"
msgstr "Непрозорість"

#: prefs/styleGroups.js
msgid "App Border"
msgstr "Рамка програми"

#: prefs/styleGroups.js
msgid "Many apps draw a thin border that the outline replaces"
msgstr "Багато програм малюють тонку рамку, яку замінює контур"

#: prefs/styleGroups.js
msgid "Hide App Border"
msgstr "Приховувати рамку"

#: prefs/styleGroups.js
msgid "Extend paints over it, Clip cuts it off"
msgstr "«Розтягнути» її зафарбовує, «Обрізати» — зрізає"

#: prefs/styleGroups.js
msgid "Inherit"
msgstr "Успадковувати"

#: prefs/styleGroups.js
msgid "Off"
msgstr "Вимкнено"

#: prefs/styleGroups.js
msgid "Extend"
msgstr "Розтягнути"

#: prefs/styleGroups.js
msgid "Clip"
msgstr "Обрізати"

#: prefs/styleGroups.js
msgid "Width"
msgstr "Ширина"

#: prefs/styleGroups.js
msgid "Style"
msgstr "Стиль"

#: prefs/styleGroups.js
msgid "Custom Style"
msgstr "Власний стиль"

#: prefs/styleGroups.js
msgid "Light Angle"
msgstr "Кут світла"

#: prefs/styleGroups.js
msgid "Outline"
msgstr "Контур"

#: prefs/styleGroups.js
msgid "Position"
msgstr "Розташування"

#: prefs/styleGroups.js
msgid "Inside"
msgstr "Усередині"

#: prefs/styleGroups.js
msgid "Center"
msgstr "По центру"

#: prefs/styleGroups.js
msgid "Outside"
msgstr "Зовні"

#: prefs/styleGroups.js
msgid "Color"
msgstr "Колір"

#: prefs/styleGroups.js
msgid "Shadow"
msgstr "Тінь"

#: prefs/styleGroups.js
msgid "Distance"
msgstr "Відстань"

#: prefs/styleGroups.js
msgid "Blur"
msgstr "Розмиття"

#: prefs/styleGroups.js
msgid "Corner Radius"
msgstr "Радіус кутів"

#. Translators: Keep the values in this order.
#: prefs/styleGroups.js
#, javascript-format
msgid "Width %d px, opacity %s"
msgstr "Ширина %d пікс., непрозорість %s"

#. Translators: Keep the values in this order.
#: prefs/styleGroups.js
#, javascript-format
msgid "Light angle %d°, distance %d px, blur %d px, opacity %s"
msgstr "Кут світла %d°, відстань %d пікс., розмиття %d пікс., непрозорість %s"
