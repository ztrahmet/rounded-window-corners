msgstr "Aplikacje i zestawy narzędzi"

#: prefs/appStylesPage.js
msgid "An app’s style comes before its toolkit’s"
msgstr "Styl aplikacji ma pierwszeństwo przed stylem jej zestawu narzędzi"

#: prefs/appStylesPage.js
msgid "Needs Round libadwaita Apps"
msgstr "Wymaga włączenia opcji „Zaokrąglanie aplikacji libadwaita”"

#: prefs/appStylesPage.js
msgid "Needs Round libhandy Apps"
msgstr "Wymaga włączenia opcji „Zaokrąglanie aplikacji libhandy”"

#: prefs/appStylesPage.js
msgid "Replaces the toolkit and general styles"
msgstr "Zastępuje styl zestawu narzędzi i styl ogólny"

#: prefs/appStylesPage.js
msgid "Replaces the general style"
msgstr "Zastępuje styl ogólny"

#: prefs/appsPage.js
msgid "Apps"
msgstr "Aplikacje"

#: prefs/appsPage.js
msgid "Active List"
msgstr "Aktywna lista"

#: prefs/appsPage.js
msgid "Switching keeps both lists"
msgstr "Po przełączeniu obie listy zostają zachowane"

#: prefs/appsPage.js
msgid "Blocklist"
msgstr "Lista blokowanych"

#: prefs/appsPage.js
msgid "Allowlist"
msgstr "Lista dozwolonych"

#: prefs/appsPage.js
msgid "These apps are never rounded"
msgstr "Te aplikacje nigdy nie są zaokrąglane"

#: prefs/appsPage.js
msgid "Only these apps are rounded"
msgstr "Zaokrąglane są tylko te aplikacje"

#: prefs/generalPage.js
msgid "General"
msgstr "Ogólne"

#: prefs/generalPage.js
msgid "Windows"
msgstr "Okna"

#: prefs/generalPage.js
msgid "Round libadwaita Apps"
msgstr "Zaokrąglanie aplikacji libadwaita"

#: prefs/generalPage.js
msgid "Only needed for a custom style or when maximized"
msgstr "Potrzebne tylko dla niestandardowego stylu lub zmaksymalizowanych okien"

#: prefs/generalPage.js
msgid "Round libhandy Apps"
msgstr "Zaokrąglanie aplikacji libhandy"

#: prefs/generalPage.js
msgid "Not all of them round their own windows"
msgstr "Nie wszystkie same zaokrąglają swoje okna"

#: prefs/generalPage.js
msgid "Round Maximized and Tiled Windows"
msgstr "Zaokrąglanie zmaksymalizowanych i kafelkowanych okien"

#: prefs/generalPage.js
msgid "Without a shadow, as in libadwaita; fullscreen stays square"
msgstr "Bez cienia, jak w libadwaita; okna na pełnym ekranie mają proste rogi"

#: prefs/generalPage.js
msgid "Replaces libadwaita’s style and gtk.css"
msgstr "Zastępuje styl libadwaita i gtk.css"

#: prefs/generalPage.js
msgid "Reset All Settings…"
msgstr "Przywróć wszystkie ustawienia…"

#: prefs/generalPage.js
msgid "Reset All Settings?"
msgstr "Przywrócić wszystkie ustawienia?"

#: prefs/generalPage.js
msgid "Every switch, list and style goes back to its default"
msgstr "Wszystkie przełączniki, listy i style wrócą do wartości domyślnych"

#: prefs/generalPage.js
msgid "Cancel"
msgstr "Anuluj"

#: prefs/generalPage.js
msgid "Reset"
msgstr "Przywróć"

