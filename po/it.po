#: prefs/appStylesPage.js
msgid "Apps and Toolkits"
msgstr "Applicazioni e toolkit"

#: prefs/appStylesPage.js
msgid "An app’s style comes before its toolkit’s"
msgstr "Lo stile di un'applicazione ha la precedenza su quello del suo toolkit"

#: prefs/appStylesPage.js
msgid "Needs Round libadwaita Apps"
msgstr "Richiede «Arrotonda le applicazioni libadwaita»"

#: prefs/appStylesPage.js
msgid "Needs Round libhandy Apps"
msgstr "Richiede «Arrotonda le applicazioni libhandy»"

#: prefs/appStylesPage.js
msgid "Replaces the toolkit and general styles"
msgstr "Sostituisce lo stile del toolkit e quello generale"

#: prefs/appStylesPage.js
msgid "Replaces the general style"
msgstr "Sostituisce lo stile generale"

#: prefs/appsPage.js
msgid "Apps"
msgstr "Applicazioni"

#: prefs/appsPage.js
msgid "Active List"
msgstr "Lista attiva"

#: prefs/appsPage.js
msgid "Switching keeps both lists"
msgstr "Cambiando lista si mantengono entrambe"

#: prefs/appsPage.js
msgid "Blocklist"
msgstr "Elenco bloccati"

#: prefs/appsPage.js
msgid "Allowlist"
msgstr "Elenco consentiti"

#: prefs/appsPage.js
msgid "These apps are never rounded"
msgstr "Queste applicazioni non vengono mai arrotondate"

#: prefs/appsPage.js
msgid "Only these apps are rounded"
msgstr "Vengono arrotondate solo queste applicazioni"

#: prefs/generalPage.js
msgid "General"
msgstr "Generale"

#: prefs/generalPage.js
msgid "Windows"
msgstr "Finestre"

#: prefs/generalPage.js
msgid "Round libadwaita Apps"
msgstr "Arrotonda le applicazioni libadwaita"

#: prefs/generalPage.js
msgid "Only needed for a custom style or when maximized"
msgstr "Serve solo per uno stile personalizzato o con le finestre massimizzate"

#: prefs/generalPage.js
msgid "Round libhandy Apps"
msgstr "Arrotonda le applicazioni libhandy"

#: prefs/generalPage.js
msgid "Not all of them round their own windows"
msgstr "Non tutte arrotondano da sé le proprie finestre"

#: prefs/generalPage.js
msgid "Round Maximized and Tiled Windows"
msgstr "Arrotonda le finestre massimizzate e affiancate"

#: prefs/generalPage.js
msgid "Without a shadow, as in libadwaita; fullscreen stays square"
msgstr "Senza ombra, come in libadwaita; a schermo intero restano squadrate"

#: prefs/generalPage.js
msgid "Replaces libadwaita’s style and gtk.css"
msgstr "Sostituisce lo stile di libadwaita e gtk.css"

#: prefs/generalPage.js
msgid "Reset All Settings…"
msgstr "Ripristina tutte le impostazioni…"

#: prefs/generalPage.js
msgid "Reset All Settings?"
msgstr "Ripristinare tutte le impostazioni?"

#: prefs/generalPage.js
msgid "Every switch, list and style goes back to its default"
msgstr "Tutti gli interruttori, le liste e gli stili tornano ai valori predefiniti"

#: prefs/generalPage.js
msgid "Cancel"
msgstr "Annulla"

#: prefs/generalPage.js
msgid "Reset"
msgstr "Ripristina"

