msgstr "Стили"

#: prefs/appStylesPage.js
msgid "Apps and Toolkits"
msgstr "Приложения и инструментарии"

#: prefs/appStylesPage.js
msgid "An app’s style comes before its toolkit’s"
msgstr "Стиль приложения важнее стиля его инструментария"

#: prefs/appStylesPage.js
msgid "Needs Round libadwaita Apps"
msgstr "Требуется параметр «Скруглять приложения libadwaita»"

#: prefs/appStylesPage.js
msgid "Needs Round libhandy Apps"
msgstr "Требуется параметр «Скруглять приложения libhandy»"

#: prefs/appStylesPage.js
msgid "Replaces the toolkit and general styles"
msgstr "Заменяет стиль инструментария и общий стиль"

#: prefs/appStylesPage.js
msgid "Replaces the general style"
msgstr "Заменяет общий стиль"

#: prefs/appsPage.js
msgid "Apps"
msgstr "Приложения"

#: prefs/appsPage.js
msgid "Active List"
msgstr "Активный список"

#: prefs/appsPage.js
msgid "Switching keeps both lists"
msgstr "При переключении оба списка сохраняются"

#: prefs/appsPage.js
msgid "Blocklist"
msgstr "Список запрещённых"

#: prefs/appsPage.js
msgid "Allowlist"
msgstr "Список разрешённых"

#: prefs/appsPage.js
msgid "These apps are never rounded"
msgstr "Эти приложения никогда не скругляются"

#: prefs/appsPage.js
msgid "Only these apps are rounded"
msgstr "Скругляются только эти приложения"

#: prefs/generalPage.js
msgid "General"
msgstr "Общие"

#: prefs/generalPage.js
msgid "Windows"
msgstr "Окна"

#: prefs/generalPage.js
msgid "Round libadwaita Apps"
msgstr "Скруглять приложения libadwaita"

#: prefs/generalPage.js
msgid "Only needed for a custom style or when maximized"
msgstr "Нужно только для своего стиля или развёрнутых окон"

#: prefs/generalPage.js
msgid "Round libhandy Apps"
msgstr "Скруглять приложения libhandy"

#: prefs/generalPage.js
msgid "Not all of them round their own windows"
msgstr "Не все из них скругляют свои окна сами"

#: prefs/generalPage.js
msgid "Round Maximized and Tiled Windows"
msgstr "Скруглять развёрнутые и прикреплённые окна"

#: prefs/generalPage.js
msgid "Without a shadow, as in libadwaita; fullscreen stays square"
msgstr "Без тени, как в libadwaita; полноэкранные окна не скругляются"

#: prefs/generalPage.js
msgid "Replaces libadwaita’s style and gtk.css"
msgstr "Заменяет стиль libadwaita и gtk.css"

#: prefs/generalPage.js
msgid "Reset All Settings…"
msgstr "Сбросить все настройки…"

#: prefs/generalPage.js
msgid "Reset All Settings?"
msgstr "Сбросить все настройки?"

#: prefs/generalPage.js
msgid "Every switch, list and style goes back to its default"
msgstr "Все переключатели, списки и стили вернутся к значениям по умолчанию"

#: prefs/generalPage.js
msgid "Cancel"
msgstr "Отмена"

#: prefs/generalPage.js
msgid "Reset"
msgstr "Сбросить"

