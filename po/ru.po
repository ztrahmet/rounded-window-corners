#: prefs/generalPage.js:28
msgid "Round libadwaita Apps"
msgstr "Скруглять приложения libadwaita"

#: prefs/generalPage.js:28
msgid "Only needed for a custom style or when maximized"
msgstr "Нужно только для своего стиля или развёрнутых окон"

#: prefs/generalPage.js:29
msgid "Round libhandy Apps"
msgstr "Скруглять приложения libhandy"

#: prefs/generalPage.js:29
msgid "Not all of them round their own windows"
msgstr "Не все из них скругляют свои окна сами"

#: prefs/generalPage.js:30
msgid "Round Maximized and Tiled Windows"
msgstr "Скруглять развёрнутые и прикреплённые окна"

#: prefs/generalPage.js:31
msgid "They get no shadow, and fullscreen windows stay square"
msgstr "Они без тени, а полноэкранные окна остаются с прямыми углами"

#: prefs/generalPage.js:38
msgid "Replaces libadwaita’s style and gtk.css"
msgstr "Заменяет стиль libadwaita и gtk.css"
