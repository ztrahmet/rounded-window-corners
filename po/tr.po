msgid "Windows"
msgstr "Pencereler"

#: prefs/generalPage.js
msgid "Round libadwaita Apps"
msgstr "libadwaita Uygulamalarını Yuvarlat"

#: prefs/generalPage.js
msgid "Only needed for a custom style or when maximized"
msgstr "Yalnızca özel biçim için veya ekranı kaplayan pencerelerde gerekir"

#: prefs/generalPage.js
msgid "Round libhandy Apps"
msgstr "libhandy Uygulamalarını Yuvarlat"

#: prefs/generalPage.js
msgid "Not all of them round their own windows"
msgstr "Hepsi kendi pencerelerini yuvarlatmaz"

#: prefs/generalPage.js
msgid "Round Maximized and Tiled Windows"
msgstr "Ekranı Kaplayan ve Döşenmiş Pencereleri Yuvarlat"

#: prefs/generalPage.js
msgid "Without a shadow, as in libadwaita; fullscreen stays square"
msgstr "libadwaita’daki gibi gölgesiz; tam ekran köşeli kalır"

#: prefs/generalPage.js
msgid "Keep Windows Sharp"
msgstr "Pencereleri Net Tut"

#: prefs/generalPage.js
msgid "At fractional scales and in the overview"
msgstr "Kesirli ölçeklerde ve genel görünümde"

#: prefs/generalPage.js
msgid "Replaces libadwaita’s style and gtk.css"
msgstr "libadwaita biçimi ve gtk.css yerine kullanılır"

#: prefs/generalPage.js
msgid "Reset All Settings…"
msgstr "Tüm Ayarları Sıfırla…"

#: prefs/generalPage.js
msgid "Reset All Settings?"
msgstr "Tüm Ayarlar Sıfırlansın mı?"

#: prefs/generalPage.js
msgid "Every switch, list and style goes back to its default"
