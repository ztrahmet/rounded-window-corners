#: prefs/generalPage.js
msgid "General"
msgstr "Allgemein"

#: prefs/generalPage.js
msgid "Windows"
msgstr "Fenster"

#: prefs/generalPage.js
msgid "Round libadwaita Apps"
msgstr "libadwaita-Anwendungen abrunden"

#: prefs/generalPage.js
msgid "Only needed for a custom style or when maximized"
msgstr "Nur für einen eigenen Stil oder maximierte Fenster nötig"

#: prefs/generalPage.js
msgid "Round libhandy Apps"
msgstr "libhandy-Anwendungen abrunden"

#: prefs/generalPage.js
msgid "Not all of them round their own windows"
msgstr "Nicht alle runden ihre Fenster selbst ab"

#: prefs/generalPage.js
msgid "Round Maximized and Tiled Windows"
msgstr "Maximierte und gekachelte Fenster abrunden"

#: prefs/generalPage.js
msgid "Without a shadow, as in libadwaita; fullscreen stays square"
msgstr "Ohne Schatten wie in libadwaita, Vollbild bleibt eckig"

