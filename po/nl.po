#: prefs/styleGroups.js
msgid "Many apps draw a thin border that the outline replaces"
msgstr "Veel toepassingen tekenen een dunne rand die door de omlijning wordt vervangen"

#: prefs/styleGroups.js
msgid "Hide App Border"
msgstr "Rand verbergen"

#: prefs/styleGroups.js
msgid "Extend paints over it, Clip cuts it off"
msgstr "‘Uitbreiden’ verft eroverheen, ‘Bijsnijden’ snijdt hem weg"

#: prefs/styleGroups.js
msgid "Inherit"
msgstr "Overnemen"

#: prefs/styleGroups.js
msgid "Off"
msgstr "Uit"

#: prefs/styleGroups.js
msgid "Extend"
