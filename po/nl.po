#: prefs/appStylesPage.js
msgid "App Styles"
msgstr "Stijlen"

#: prefs/appStylesPage.js
msgid "Apps and Toolkits"
msgstr "Toepassingen en toolkits"

#: prefs/appStylesPage.js
msgid "An app’s style comes before its toolkit’s"
msgstr "De stijl van een toepassing gaat voor die van haar toolkit"

#: prefs/appStylesPage.js
msgid "Needs Round libadwaita Apps"
msgstr "Vereist ‘libadwaita-toepassingen afronden’"

#: prefs/appStylesPage.js
msgid "Needs Round libhandy Apps"
msgstr "Vereist ‘libhandy-toepassingen afronden’"

#: prefs/appStylesPage.js
msgid "Replaces the toolkit and general styles"
msgstr "Vervangt de stijl van de toolkit en de algemene stijl"

#: prefs/appStylesPage.js
msgid "Replaces the general style"
msgstr "Vervangt de algemene stijl"

#: prefs/appsPage.js
msgid "Apps"
msgstr "Toepassingen"

#: prefs/appsPage.js
msgid "Active List"
msgstr "Actieve lijst"

#: prefs/appsPage.js
msgid "Switching keeps both lists"
msgstr "Bij wisselen blijven beide lijsten behouden"

#: prefs/appsPage.js
msgid "Blocklist"
msgstr "Blokkeerlijst"

#: prefs/appsPage.js
msgid "Allowlist"
msgstr "Toelatingslijst"

#: prefs/appsPage.js
msgid "These apps are never rounded"
msgstr "Deze toepassingen worden nooit afgerond"

#: prefs/appsPage.js
msgid "Only these apps are rounded"
msgstr "Alleen deze toepassingen worden afgerond"

#: prefs/generalPage.js
msgid "General"
msgstr "Algemeen"

#: prefs/generalPage.js
msgid "Windows"
msgstr "Vensters"

#: prefs/generalPage.js
msgid "Round libadwaita Apps"
msgstr "libadwaita-toepassingen afronden"

#: prefs/generalPage.js
msgid "Only needed for a custom style or when maximized"
msgstr "Alleen nodig voor een aangepaste stijl of gemaximaliseerde vensters"

#: prefs/generalPage.js
msgid "Round libhandy Apps"
msgstr "libhandy-toepassingen afronden"

#: prefs/generalPage.js
msgid "Not all of them round their own windows"
msgstr "Niet alle ronden hun vensters zelf af"

#: prefs/generalPage.js
msgid "Round Maximized and Tiled Windows"
msgstr "Gemaximaliseerde en getegelde vensters afronden"

#: prefs/generalPage.js
msgid "Without a shadow, as in libadwaita; fullscreen stays square"
msgstr "Zonder schaduw, zoals in libadwaita; volledig scherm blijft hoekig"

#: prefs/generalPage.js
msgid "Round Overview Windows"
msgstr "Vensters in het overzicht afronden"

#: prefs/generalPage.js
msgid "Off, the overview shows them as their apps draw them"
msgstr "Indien uitgeschakeld toont het overzicht de vensters zoals hun toepassingen ze tekenen"

#: prefs/generalPage.js
msgid "Keep Windows Sharp (Experimental)"
msgstr "Vensters scherp houden (experimenteel)"

#: prefs/generalPage.js
msgid "At fractional scales and in the overview"
msgstr "Bij fractionele schalen en in het overzicht"

#: prefs/generalPage.js
msgid "Replaces libadwaita’s style and gtk.css"
msgstr "Vervangt de stijl van libadwaita en gtk.css"

#: prefs/generalPage.js
msgid "Reset All Settings…"
msgstr "Alle instellingen herstellen…"

#: prefs/generalPage.js
msgid "Reset All Settings?"
msgstr "Alle instellingen herstellen?"

#: prefs/generalPage.js
msgid "Every switch, list and style goes back to its default"
msgstr "Alle schakelaars, lijsten en stijlen gaan terug naar hun standaardwaarde"

#: prefs/generalPage.js
msgid "Cancel"
msgstr "Annuleren"

#: prefs/generalPage.js
msgid "Reset"
msgstr "Herstellen"

#: prefs/styleGroups.js
msgid "Opacity"
msgstr "Dekking"

#: prefs/styleGroups.js
msgid "App Border"
