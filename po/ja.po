#: prefs/appsPage.js
msgid "Apps"
msgstr "アプリ"

#: prefs/appsPage.js
msgid "Active List"
msgstr "有効なリスト"

#: prefs/appsPage.js
msgid "Switching keeps both lists"
msgstr "切り替えても両方のリストは保持されます"

#: prefs/appsPage.js
msgid "Blacklist"
msgstr "ブラックリスト"

#: prefs/appsPage.js
msgid "Whitelist"
msgstr "ホワイトリスト"

#: prefs/appsPage.js
msgid "These apps are never rounded"
msgstr "これらのアプリは角を丸めません"

#: prefs/appsPage.js
msgid "Only these apps are rounded"
msgstr "これらのアプリだけ角を丸めます"

#: prefs/appStylesPage.js
msgid "App Styles"
msgstr "スタイル"

#: prefs/appStylesPage.js
msgid "Apps and Categories"
msgstr "アプリとカテゴリ"

#: prefs/appStylesPage.js
msgid "An app’s style comes before its category’s"
msgstr "アプリのスタイルはカテゴリのスタイルより優先されます"

#: prefs/appStylesPage.js
msgid "Needs Round libadwaita Apps"
msgstr "“libadwaita アプリの角を丸める”をオンにする必要があります"

#: prefs/appStylesPage.js
msgid "Needs Round libhandy Apps"
msgstr "“libhandy アプリの角を丸める”をオンにする必要があります"

#: prefs/appStylesPage.js
msgid "Replaces the category and general styles"
msgstr "カテゴリと全般のスタイルを置き換えます"

#: prefs/appStylesPage.js
msgid "Replaces the general style"
msgstr "全般のスタイルを置き換えます"

#: prefs/generalPage.js
msgid "General"
msgstr "全般"

#: prefs/generalPage.js
msgid "Windows"
msgstr "ウィンドウ"

#: prefs/generalPage.js
msgid "Round libadwaita Apps"
msgstr "libadwaita アプリの角を丸める"

#: prefs/generalPage.js
msgid "Only needed for a custom style or when maximized"
msgstr "カスタムスタイルや最大化時にのみ必要です"

#: prefs/generalPage.js
msgid "Round libhandy Apps"
msgstr "libhandy アプリの角を丸める"

#: prefs/generalPage.js
msgid "Not all of them round their own windows"
msgstr "すべてのアプリが自分でウィンドウの角を丸めるわけではありません"

#: prefs/generalPage.js
msgid "Round Maximized and Tiled Windows"
msgstr "最大化・タイル表示のウィンドウの角を丸める"

#: prefs/generalPage.js
msgid "Without a shadow, as in libadwaita; fullscreen stays square"
msgstr "libadwaita と同様に影なし。全画面では角を丸めません"

#: prefs/generalPage.js
msgid "Replaces libadwaita’s style and gtk.css"
msgstr "libadwaita のスタイルと gtk.css を置き換えます"

#: prefs/generalPage.js
msgid "Reset All Settings…"
msgstr "すべての設定をリセット…"

#: prefs/generalPage.js
msgid "Reset All Settings?"
msgstr "すべての設定をリセットしますか?"

#: prefs/generalPage.js
msgid "Every switch, list and style goes back to its default"
msgstr "すべてのスイッチ、リスト、スタイルがデフォルトに戻ります"

#: prefs/generalPage.js
msgid "Cancel"
msgstr "キャンセル"

#: prefs/generalPage.js
msgid "Reset"
msgstr "リセット"
