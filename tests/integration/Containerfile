# Headless GNOME Shell for the integration tests, on the Fedora release that ships it.
ARG FEDORA=45
FROM registry.fedoraproject.org/fedora:${FEDORA}

RUN dnf install -y --setopt=install_weak_deps=False \
        gnome-shell mesa-dri-drivers dbus-daemon \
        libadwaita-demo procps-ng zip unzip xprop python3 \
    && dnf clean all

# A video window whose main buffer is 1x1, stretched by a viewport, as mpv's dmabuf-wayland output draws it.
RUN dnf install -y --setopt=install_weak_deps=False \
        gstreamer1 gstreamer1-plugins-base gstreamer1-plugins-bad-free \
    && dnf clean all

# Real GTK themes, to check that the extension ignores them as libadwaita does.
RUN dnf install -y --setopt=install_weak_deps=False --skip-unavailable \
        arc-theme breeze-gtk-gtk4 yaru-gtk4-theme \
    && dnf clean all

# The image has /run/systemd but no logind, which makes the shell abort at startup.
RUN rm -rf /run/systemd

RUN useradd -m runner
